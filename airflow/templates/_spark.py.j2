

class SparkBatch(DataprocCreateBatchOperator):
    """Submit only when the vCPU quota is free: a finished batch releases its 12 vCPUs ~1 min after
    Airflow sees it succeed. The task holds the `spark` pool slot while it waits, then while the batch runs."""

    def execute(self, context):
        for _ in range(40):  # up to 10 min, then submit anyway (Dataproc gives a clear quota error)
            quotas = compute_v1.ProjectsClient().get(project=PROJECT).quotas
            if next(q.usage for q in quotas if q.metric == "CPUS_ALL_REGIONS") == 0:
                break
            self.log.info("waiting: vCPU quota still in use (another batch is ending)")
            time.sleep(15)
        return super().execute(context)


def spark_batch(name, entry, args, **kwargs):
    """One Serverless Spark batch running spark/<entry> (deployed by CI) with the lab's settings."""
    # Dataproc batch id: [a-z0-9-], unique per run (to the microsecond) and per attempt.
    batch_id = name + "-{{ dag_run.run_after.strftime('%Y%m%d-%H%M%S-%f') }}-{{ ti.try_number }}"
    return SparkBatch(
        task_id=entry.removesuffix(".py"),
        pool="spark",  # 1 slot: the trial's 12 vCPU quota fits one Spark batch at a time
        # Not deferrable: with one pool slot only one batch runs anyway, so the task simply holds the slot
        # from submit to finish (no "deferred" state, no wait for a slot to resume).
        project_id=PROJECT,
        region=REGION,
        batch_id=batch_id,
        batch={
            "pyspark_batch": {
                "main_python_file_uri": f"gs://{PROJECT}-code/spark/{entry}",
                "python_file_uris": [f"gs://{PROJECT}-code/spark/lib.zip"],
                "args": [*args, "--batch-id=" + batch_id],
            },
            "runtime_config": {
                "version": "2.3",
                # Same as scripts/run-spark.sh: smallest footprint (12 vCPU) + Iceberg catalog "lake".
                "properties": {
                    "spark.driver.cores": "4",
                    "spark.executor.cores": "4",
                    "spark.executor.instances": "2",
                    "spark.dynamicAllocation.enabled": "false",
                    "spark.dataproc.driver.disk.size": "250g",
                    "spark.dataproc.executor.disk.size": "250g",
                    "spark.sql.session.timeZone": "UTC",
                    "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
                    "spark.sql.catalog.lake": "org.apache.iceberg.spark.SparkCatalog",
                    "spark.sql.catalog.lake.type": "bigquery",
                    "spark.sql.catalog.lake.gcp_project": PROJECT,
                    "spark.sql.catalog.lake.gcp_location": REGION,
                    "spark.sql.catalog.lake.warehouse": f"gs://{PROJECT}-lake/iceberg",
                },
            },
            "environment_config": {
                "execution_config": {
                    "service_account": f"spark-runner@{PROJECT}.iam.gserviceaccount.com",
                    "subnetwork_uri": "default",
                },
            },
        },
        **kwargs,
    )
