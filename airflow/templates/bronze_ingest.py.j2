[% extends "_base.py.j2" %]
[% block helpers %][% include "_spark.py.j2" %][% endblock %]
[% block params %]"mode": Param("incremental", enum=["incremental", "full_refresh"])[% endblock %]
[% block tasks %]
    spark_batch(
        "bronze-" + [[ feed | py ]],
        "bronze_transform.py",
        ["--source=" + [[ source | py ]], "--feed=" + [[ feed | py ]], "--mode={{ params.mode }}",
         f"--landing=gs://{PROJECT}-landing"],
        outlets=[Asset("bronze." + [[ feed | py ]])],  # DAGs with `after: bronze.<feed>` run when this succeeds
    )
[% endblock %]
